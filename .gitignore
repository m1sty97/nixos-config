# 忽略 flake.lock（可选择是否提交）
# flake.lock

# 忽略结果符号链接
result
result-*

# 忽略编辑器临时文件
*~
.*.swp
.*.swo
\#*\#
.\#*

# 忽略 hardware-configuration 的备份
hardware-configuration.nix.bak

# =============================================================================
# sops 密钥安全 — 确保明文密钥文件永远不会被提交
# =============================================================================

# age 私钥（绝对不能提交！）
age/keys.txt
*.age

# ⚠️ 明文过渡期：secrets.yaml 暂时以明文形式存在于工作区（待填写后由 sops 重新加密）。
# 加密完成后：删除下面这一行，再 git add secrets/secrets.yaml 提交加密版本。
secrets/secrets.yaml

# sops 解密后的明文文件（sops -d 输出）
secrets/*.decrypted.*
secrets/*-plaintext.*

# sops 备份文件
secrets/*.bak
secrets/*.old
