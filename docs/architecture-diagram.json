  "cards": [
    {
      "dot": "cyan",
      "title": "组装层",
      "items": [
        "flake inputs 统一 follows nixpkgs（南大镜像 git+https）",
        "specialArgs 携带 inputs/mylib/myvars/pkgs-stable 进入所有模块",
        "mylib.scanPaths 自动导入目录下的模块文件"
      ]
    },
    {
      "dot": "emerald",
      "title": "桌面主机",
      "items": [
        "Niri 与 Hyprland 同时安装，登录时经 tuigreet 会话菜单切换",
        "Noctalia Shell + fcitx5 为两合成器共用配置",
        "disko 声明磁盘：ESP + swap + btrfs（@/@home/@nix）"
      ]
    },
    {
      "dot": "rose",
      "title": "安全与密钥",
      "items": [
        "sops-nix：密码哈希在用户创建前解密，SSH 公钥运行时读取",
        "root 密码已锁定，提权仅走 sudo",
        "sshd 禁止密码登录，仅密钥认证"
      ]
    }
  ],
  "layout": {
    "mode": "grid",
    "cols": 5,
    "gapX": 60,
    "gapY": 110,
    "cellW": 130,
    "cellH": 84
