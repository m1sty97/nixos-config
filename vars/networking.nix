# =============================================================================
# vars/networking.nix — 网络配置变量
# -----------------------------------------------------------------------------
# 集中管理网关、DNS、各主机 IP 地址等网络参数。
# =============================================================================
{ lib }:
rec {
  # ---------------------------------------------------------------------------
  # 默认网关和 DNS
  # ---------------------------------------------------------------------------
  mainGateway = "192.168.1.1"; # 主路由器 IPv4 网关
  mainGateway6 = "fe80::1"; # 主路由器 IPv6 链路本地地址
  nameservers = [
    "223.5.5.5" # AliDNS 阿里 DNS
    "119.29.29.29" # DNSPod 腾讯 DNS
    "1.1.1.1" # Cloudflare DNS
  ];
  prefixLength = 24; # 子网前缀长度

  # ---------------------------------------------------------------------------
  # 各主机的网络地址配置
  # iface — 网络接口名称（用 `ip link` 查看实际名称）
  # ipv4  — 静态 IPv4 地址
  # ---------------------------------------------------------------------------
  hostsAddr = {
    # 桌面主机
    misty-desktop = {
      iface = "enp0s25"; # 有线网卡接口名（请根据实际硬件修改）
      ipv4 = "192.168.1.100";
    };
    # 虚拟化服务器
    misty-server = {
      iface = "eno1"; # 服务器网卡接口名（请根据实际硬件修改）
      ipv4 = "192.168.1.200";
    };
  };

  # ---------------------------------------------------------------------------
  # SSH 配置 — 写入 /etc/ssh/ssh_config 的主机别名
  # ---------------------------------------------------------------------------
  ssh = {
    extraConfig = lib.attrsets.foldlAttrs (
      acc: host: val:
      acc + ''
        Host ${host}
          HostName ${val.ipv4}
          Port 22
      ''
    ) "" hostsAddr;

    # 已知主机公钥（用于 SSH 主机验证）
    knownHosts = { };
  };
}
