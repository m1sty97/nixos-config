# =============================================================================
# vars/networking.nix — 网络配置变量
# -----------------------------------------------------------------------------
# 所有主机使用 DHCP 动态获取地址（NetworkManager 管理），
# 不配置静态 IP / 网关；hostsAddr 仅记录接口名与 SSH 别名用的预期地址。
# =============================================================================
{ lib }:
{
  # ---------------------------------------------------------------------------
  # 各主机的网络接口
  # iface — 网络接口名称（用 `ip link` 查看实际名称）
  # ipv4  — DHCP 分配的预期地址（以实际获取为准，仅用于 SSH 别名解析）
  # ---------------------------------------------------------------------------
  hostsAddr = {
    # 桌面主机
    misty-desktop = {
      iface = ""; # 待定：装机后用 `ip link` 确认实际接口名
      ipv4 = "192.168.177.147";
    };
    # 虚拟化服务器
    misty-server = {
      iface = "ens18";
      ipv4 = "192.168.177.200";
    };
  };

  # ---------------------------------------------------------------------------
  # SSH 配置 — 写入 /etc/ssh/ssh_config 的主机别名
  # ---------------------------------------------------------------------------
  ssh = {
    extraConfig = lib.attrsets.foldlAttrs (
      acc: host: val:
      acc + ''
        Host ${host}
          HostName ${val.ipv4}
          Port 22
      ''
    ) "" hostsAddr;

    # 已知主机公钥（用于 SSH 主机验证）
    knownHosts = { };
  };
}
