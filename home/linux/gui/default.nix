# =============================================================================
# home/linux/gui/default.nix — Linux GUI 配置入口
# -----------------------------------------------------------------------------
# 导入两个合成器共用的 GUI 配置（noctalia、fcitx5）。
# WM 模块（niri.nix、hyprland.nix）不在此处导入，
# 由桌面主机的 home 入口文件（home/hosts/linux/misty-desktop.nix）
# 显式导入并按需启用，模块内部用 mkIf 条件控制实际生效范围。
# =============================================================================
{ ... }:
{
  imports = [
    # 共用 GUI 配置
    ./noctalia.nix
    ./fcitx5.nix
  ];
}
