// =============================================================================
// niri/conf/config.kdl — Niri 主配置文件
// -----------------------------------------------------------------------------
// Niri 是一个 scrollable-tiling Wayland 合成器。
// 配置文档：https://yalter.github.io/niri/Configuration:-Introduction
//
// 此文件通过 include 引入其他配置片段：
//   - keybindings.kdl    快捷键
//   - windowrules.kdl    窗口规则
//   - spawn-at-startup.kdl 启动时执行的程序
// =============================================================================

include "./keybindings.kdl"
include "./windowrules.kdl"
include "./spawn-at-startup.kdl"

// -----------------------------------------------------------------------------
// 输入设备配置
// 文档：https://yalter.github.io/niri/Configuration:-Input
// -----------------------------------------------------------------------------
input {
    keyboard {
        xkb {
            // 键盘布局设置
            // layout "us,cn"
            // options "grp:win_space_toggle"
        }

        // 启用 NumLock（取消注释）
        // numlock

        // 键盘重复参数（默认值与 wlroots/sway 一致）
        // repeat-delay 600   // 重复开始延迟（毫秒）
        // repeat-rate 25     // 重复速率（字符/秒）
    }

    // 触摸板设置
    touchpad {
        dwt              // 打字时禁用触摸板
        natural-scroll   // 自然滚动方向
        // tap             // 点击模拟点击
        // accel-speed 0.2
        // accel-profile "flat"
    }

    // 鼠标设置
    mouse {
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
    }

    // 鼠标自动跟随焦点窗口（取消注释启用）
    // warp-mouse-to-focus
}

// -----------------------------------------------------------------------------
// 布局设置
// 文档：https://yalter.github.io/niri/Configuration:-Layout
// -----------------------------------------------------------------------------
layout {
    // 窗口间距（逻辑像素）
    gaps 8

    // 列居中策略
    // "never"       — 聚焦离屏列时保持在边缘（默认）
    // "always"      — 聚焦列始终居中
    // "on-overflow" — 仅当列无法完整显示时居中
    center-focused-column "never"

    // 预设列宽（Mod+R 切换）
    preset-column-widths {
        proportion 0.333333   // 1/3 屏宽
        proportion 0.500000   // 1/2 屏宽
        proportion 0.666667   // 2/3 屏宽
    }

    // 边框设置
    border {
        off               // 关闭边框（使用间距分隔窗口）
        // on
        // width 2
    }

    // 焦点环（聚焦窗口的视觉提示）
    focus-ring {
        on
        width 2
        // 使用 catppuccin macchiato 蓝色
        color 50(8aadf4ff)
        // active 的颜色
        active-color 8aadf4ff
        // inactive 的颜色
        inactive-color 494d64ff
    }

    // 预设窗口高度（Mod+Shift+R 切换）
    preset-window-heights {
        proportion 0.5
        proportion 0.666667
        proportion 1.0
    }
}

// -----------------------------------------------------------------------------
// 动画设置
// -----------------------------------------------------------------------------
animations {
    // 窗口打开动画
    window-open {
        duration-ms 150
        curve "ease-out"
    }

    // 窗口关闭动画
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    // 工作区切换动画
    workspace-switch {
        duration-ms 200
        curve "ease-out"
    }

    // 水平视图移动
    horizontal-view-movement {
        duration-ms 200
        curve "ease-out"
    }
}

// -----------------------------------------------------------------------------
// 截图设置
// -----------------------------------------------------------------------------
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// -----------------------------------------------------------------------------
// 环境变量
// -----------------------------------------------------------------------------
environment {
    QT_QPA_PLATFORM "wayland;xcb"
    XDG_SESSION_TYPE "wayland"
    MOZ_ENABLE_WAYLAND "1"
    NIXOS_OZONE_WL "1"
}

// -----------------------------------------------------------------------------
// 偏好设置
// -----------------------------------------------------------------------------
prefer-no-csd   // 禁用客户端装饰，使用 Niri 的服务端装饰

// 热键覆盖
hotkey-overlay {
    skip-at-startup
}
