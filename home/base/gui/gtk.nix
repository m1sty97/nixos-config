# =============================================================================
# home/base/gui/gtk.nix — GTK 主题和光标配置
# -----------------------------------------------------------------------------
# 统一 GTK 应用的主题、图标和光标。
# =============================================================================
{ pkgs, ... }:
{
  # ---------------------------------------------------------------------------
  # 鼠标光标主题
  # ---------------------------------------------------------------------------
  home.pointerCursor = {
    enable = true;
    gtk.enable = true;
    x11.enable = true;
    package = pkgs.bibata-cursors; # Bibata 光标主题
    name = "Bibata-Modern-Ice";
    size = 24;
  };

  # ---------------------------------------------------------------------------
  # GTK 主题设置
  # 生成文件：
  #   1. ~/.gtkrc-2.0
  #   2. ~/.config/gtk-3.0/settings.ini
  #   3. ~/.config/gtk-4.0/settings.ini
  # ---------------------------------------------------------------------------
  gtk = {
    enable = true;

    # 字体设置
    font = {
      name = "Noto Sans";
      package = pkgs.noto-fonts;
      size = 11;
    };
  };
}
