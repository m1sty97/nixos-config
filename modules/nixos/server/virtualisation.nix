# =============================================================================
# modules/nixos/server/virtualisation.nix — 服务器虚拟化客户机配置
# -----------------------------------------------------------------------------
# 此模块用于运行在虚拟化环境中的服务器主机（如 KubeVirt/Proxmox/QEMU 中的 VM）。
# 提供虚拟机客户机所需的工具，而非虚拟化服务端工具。
# =============================================================================
{
  pkgs,
  ...
}:
{
  # ---------------------------------------------------------------------------
  # QEMU 客户机支持
  # ---------------------------------------------------------------------------
  # qemu-guest-agent — 虚拟化管理平台需要，用于优雅关机、IP 获取等
  services.qemuGuest.enable = true;

  # 自动扩展根分区（虚拟机磁盘扩容时需要）
  boot.growPartition = true;

  # 串口控制台输出（虚拟化管理平台控制台需要）
  # 取消注释适用于串口控制台的虚拟化平台
  # boot.kernelParams = [ "console=ttyS0" ];

  # ---------------------------------------------------------------------------
  # 服务器基础工具包
  # 便于后续部署各种服务
  # ---------------------------------------------------------------------------
  environment.systemPackages = with pkgs; [
    # 网络工具
    iptables # 防火墙管理
    bridge-utils # 网桥管理
    bind # DNS 工具（dig/nslookup 等）
    tcpdump # 抓包工具

    # 监控工具
    htop # 进程监控
    iotop # I/O 监控
    iftop # 网络流量监控
    nethogs # 按进程网络流量

    # 文件传输
    rsync # 增量文件同步

    # 系统工具
    tmux # 终端复用器（SSH 会话管理）
    tree # 目录树查看
    jq # JSON 处理
    curl # HTTP 客户端
    wget # 文件下载
  ];
}
