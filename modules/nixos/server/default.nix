# =============================================================================
# modules/nixos/server/default.nix — 服务器基础模块
# -----------------------------------------------------------------------------
# 服务器主机的基础配置，继承 base 模块 + 虚拟化客户机配置。
# 服务器运行在受信任的内网 LAN 中（NAT 后，WAN 由路由器保护）。
# =============================================================================
{ lib, ... }:
{
  imports = [
    ../base
    ./virtualisation.nix
  ];

  # 服务器运行在受信任的内网，关闭防火墙（安全默认值在 base/ssh.nix 中为 ON）
  networking.firewall.enable = false;
}
